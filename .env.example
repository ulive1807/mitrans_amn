# Salin menjadi .env.local lalu isi. Hanya publishable key (pk_test_… atau pk_live_…).
# Secret key Clerk (sk_…) TIDAK boleh ditaruh di sini: semua variabel VITE_ ikut terkirim ke peramban.
VITE_CLERK_PUBLISHABLE_KEY=
# Alamat API server bila beda domain (kosong = domain yang sama).
VITE_API_URL=

# ===== Hanya untuk API server (npm run server). Isi di pengaturan server, BUKAN di hosting frontend. =====
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."   (kunci publik PEM dari dasbor Clerk)
# CLERK_SECRET_KEY=                              (sk_…; rahasia, jangan dibagikan atau ditempel di percakapan)
# CLERK_AUTHORIZED_PARTIES=https://mitrans.id
